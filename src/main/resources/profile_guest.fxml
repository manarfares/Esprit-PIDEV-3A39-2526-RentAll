<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controllers.GuestController"
            prefWidth="1100" prefHeight="750"
            style="-fx-background-color: #f8f9fa;">

    <!-- ═══════════ HEADER ═══════════ -->
    <top>
        <HBox style="-fx-background-color: linear-gradient(to right, #6C63FF, #9B59B6);
                     -fx-padding: 15 25 15 25;"
              alignment="CENTER_LEFT" spacing="20">
            <Label text="🏠 RentAll"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;
                          -fx-text-fill: white;"/>
            <Label text="Guest"
                   style="-fx-font-size: 11px; -fx-text-fill: #e8e0ff;
                          -fx-background-color: rgba(255,255,255,0.2);
                          -fx-padding: 3 8 3 8; -fx-background-radius: 10;"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblWelcome"
                   style="-fx-font-size: 13px; -fx-text-fill: white;"/>
            <Button text="🚪 Déconnexion"
                    onAction="#handleLogout"
                    style="-fx-background-color: rgba(255,255,255,0.2);
                           -fx-text-fill: white; -fx-font-size: 12px;
                           -fx-background-radius: 20; -fx-cursor: hand;
                           -fx-padding: 8 16 8 16;"/>
        </HBox>
    </top>

    <!-- ═══════════ CONTENU ═══════════ -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 20;">

                <!-- ── Top row: Profile + Become Host ── -->
                <HBox spacing="20">

                    <!-- Carte Profil -->
                    <VBox spacing="15" prefWidth="420"
                          style="-fx-background-color: white;
                                 -fx-border-color: #e0e0e0;
                                 -fx-border-radius: 12;
                                 -fx-background-radius: 12;
                                 -fx-padding: 25;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="👤" style="-fx-font-size: 28px;"/>
                            <VBox>
                                <Label text="Mon Profil"
                                       style="-fx-font-size: 18px; -fx-font-weight: bold;
                                              -fx-text-fill: #2c3e50;"/>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label fx:id="lblRole"
                                           style="-fx-font-size: 11px;
                                                  -fx-text-fill: #6C63FF;
                                                  -fx-font-weight: bold;"/>
                                    <Label text="•" style="-fx-text-fill: #95a5a6;"/>
                                    <Label fx:id="lblStatus"
                                           style="-fx-font-size: 11px;
                                                  -fx-text-fill: #27ae60;"/>
                                    <Label fx:id="lblBadge" text=""
                                           style="-fx-font-size: 10px;"/>
                                </HBox>
                            </VBox>
                        </HBox>

                        <Separator/>

                        <Button text="✏️ Modifier mon profil"
                                onAction="#handleOuvrirModifier"
                                style="-fx-background-color: linear-gradient(to right, #f39c12, #e67e22);
                                       -fx-text-fill: white; -fx-font-size: 13px;
                                       -fx-font-weight: bold; -fx-pref-width: 370px;
                                       -fx-pref-height: 42px; -fx-background-radius: 21;
                                       -fx-cursor: hand;"/>

                        <Button text="🏠 Retour à l'accueil"
                                onAction="#handleRetourAccueil"
                                style="-fx-background-color: white;
                                       -fx-text-fill: #6C63FF; -fx-font-size: 13px;
                                       -fx-font-weight: bold; -fx-pref-width: 370px;
                                       -fx-pref-height: 42px; -fx-background-radius: 21;
                                       -fx-cursor: hand; -fx-border-color: #6C63FF;
                                       -fx-border-radius: 21;"/>
                    </VBox>

                    <!-- Carte Devenir Host -->
                    <VBox spacing="15" prefWidth="420"
                          style="-fx-background-color: white;
                                 -fx-border-color: #e0e0e0;
                                 -fx-border-radius: 12;
                                 -fx-background-radius: 12;
                                 -fx-padding: 25;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="🏠" style="-fx-font-size: 28px;"/>
                            <Label text="Devenir Host"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold;
                                          -fx-text-fill: #2c3e50;"/>
                        </HBox>

                        <Separator/>

                        <Label text="En tant que Host, vous pourrez :"
                               style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>

                        <VBox spacing="10">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="✅" style="-fx-font-size: 14px;"/>
                                <Label text="Ajouter des propriétés à louer"
                                       style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                            </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="✅" style="-fx-font-size: 14px;"/>
                                <Label text="Gérer vos annonces"
                                       style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                            </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="✅" style="-fx-font-size: 14px;"/>
                                <Label text="Voir vos réservations"
                                       style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                            </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="✅" style="-fx-font-size: 14px;"/>
                                <Label text="Générer des revenus"
                                       style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                            </HBox>
                        </VBox>

                        <Separator/>

                        <HBox spacing="8" alignment="CENTER_LEFT"
                              style="-fx-background-color: #fff8e1;
                                     -fx-padding: 12; -fx-background-radius: 8;">
                            <Label text="⚠️" style="-fx-font-size: 14px;"/>
                            <Label text="La demande sera examinée par un administrateur avant validation."
                                   style="-fx-font-size: 11px; -fx-text-fill: #e67e22;"
                                   wrapText="true" prefWidth="300"/>
                        </HBox>

                        <Button fx:id="btnDevenirHost"
                                text="🚀 Devenir Host"
                                onAction="#handleDevenirHost"
                                style="-fx-background-color: linear-gradient(to right, #f39c12, #e67e22);
                                       -fx-text-fill: white; -fx-font-size: 14px;
                                       -fx-font-weight: bold; -fx-pref-width: 370px;
                                       -fx-pref-height: 42px; -fx-background-radius: 21;
                                       -fx-cursor: hand;"/>
                    </VBox>

                </HBox>

                <!-- ── Browse Properties Section ── -->
                <VBox spacing="12"
                      style="-fx-background-color: white;
                             -fx-border-color: #e0e0e0;
                             -fx-border-radius: 12;
                             -fx-background-radius: 12;
                             -fx-padding: 20;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">

                    <!-- Section header -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="🏘" style="-fx-font-size: 22px;"/>
                        <Label text="Browse Properties"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;
                                      -fx-text-fill: #2c3e50;"/>
                        <HBox HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblBrowseStatus"
                               style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                    </HBox>

                    <Separator/>

                    <!-- Search and filter bar -->
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <TextField fx:id="tfSearch" promptText="🔍 Search by name or address..."
                                   prefWidth="260"
                                   style="-fx-background-radius: 20; -fx-border-radius: 20;
                                          -fx-padding: 6 12 6 12;"/>
                        <Label text="Min price:" style="-fx-font-size: 12px;"/>
                        <TextField fx:id="tfMinPrice" promptText="0" prefWidth="75"
                                   style="-fx-background-radius: 8; -fx-border-radius: 8;"/>
                        <Label text="Max price:" style="-fx-font-size: 12px;"/>
                        <TextField fx:id="tfMaxPrice" promptText="any" prefWidth="75"
                                   style="-fx-background-radius: 8; -fx-border-radius: 8;"/>
                        <Label text="Min rooms:" style="-fx-font-size: 12px;"/>
                        <TextField fx:id="tfMinRooms" promptText="0" prefWidth="60"
                                   style="-fx-background-radius: 8; -fx-border-radius: 8;"/>
                        <Button text="✕ Clear" onAction="#handleClearFilters"
                                style="-fx-background-color: #ecf0f1; -fx-border-radius: 8;
                                       -fx-background-radius: 8; -fx-cursor: hand;"/>
                    </HBox>

                    <!-- Scrollable card grid -->
                    <ScrollPane fitToWidth="true" prefHeight="420"
                                style="-fx-background-color: transparent; -fx-border-color: transparent;">
                        <FlowPane fx:id="cardGrid" hgap="14" vgap="14"
                                  style="-fx-background-color: transparent;">
                            <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                        </FlowPane>
                    </ScrollPane>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
