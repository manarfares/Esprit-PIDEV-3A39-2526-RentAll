<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.piapp.ui.LoginController"
      prefWidth="900" prefHeight="580"
      style="-fx-background-color: white;">

    <!-- ═══════════ PARTIE GAUCHE ═══════════ -->
    <VBox prefWidth="450" prefHeight="580"
          alignment="CENTER"
          style="-fx-background-color: linear-gradient(to bottom right, #6C63FF, #9B59B6);">
        <padding><Insets top="60" bottom="60" left="50" right="50"/></padding>

        <Label text="🏠 RentAll"
               style="-fx-font-size: 36px; -fx-font-weight: bold;
                      -fx-text-fill: white;"/>

        <Label text=" " style="-fx-font-size: 15px;"/>

        <Label text="🧑‍💻" style="-fx-font-size: 110px;"/>

        <Label text=" " style="-fx-font-size: 10px;"/>

        <Label text="Trouvez votre séjour idéal"
               style="-fx-font-size: 18px; -fx-font-weight: bold;
                      -fx-text-fill: white;"/>

        <Label text="Découvrez des logements uniques partout dans le monde"
               style="-fx-font-size: 12px; -fx-text-fill: #e8e0ff;
                      -fx-wrap-text: true; -fx-text-alignment: center;"
               wrapText="true"/>
    </VBox>

    <!-- ═══════════ PARTIE DROITE ═══════════ -->
    <VBox prefWidth="450" prefHeight="580"
          alignment="CENTER" spacing="16"
          style="-fx-background-color: white;">
        <padding><Insets top="50" bottom="50" left="50" right="50"/></padding>

        <Label text="Connexion"
               style="-fx-font-size: 28px; -fx-font-weight: bold;
                      -fx-text-fill: #2c3e50;"/>
        <Label text="Connectez-vous pour continuer"
               style="-fx-font-size: 12px; -fx-text-fill: #95a5a6;"/>

        <Label text=" " style="-fx-font-size: 5px;"/>

        <!-- Username -->
        <VBox spacing="5">
            <Label text="Nom d'utilisateur ou Email"
                   style="-fx-font-size: 12px; -fx-font-weight: bold;
                          -fx-text-fill: #2c3e50;"/>
            <TextField fx:id="tfUsername"
                       promptText="username ou email"
                       style="-fx-pref-height: 42px; -fx-font-size: 13px;
                              -fx-background-color: #f8f9fa;
                              -fx-border-color: #e0e0e0;
                              -fx-border-radius: 8; -fx-background-radius: 8;
                              -fx-padding: 0 12 0 12;"/>
        </VBox>

        <!-- Password -->
        <VBox spacing="5">
            <Label text="Mot de passe"
                   style="-fx-font-size: 12px; -fx-font-weight: bold;
                          -fx-text-fill: #2c3e50;"/>
            <PasswordField fx:id="pfPassword"
                           promptText="••••••••"
                           style="-fx-pref-height: 42px; -fx-font-size: 13px;
                                  -fx-background-color: #f8f9fa;
                                  -fx-border-color: #e0e0e0;
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-padding: 0 12 0 12;"/>
        </VBox>

        <!-- Erreur -->
        <Label fx:id="lblErreur" text=""
               style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"/>

        <!-- Bouton Login -->
        <Button text="Se connecter"
                onAction="#handleLogin"
                style="-fx-background-color: linear-gradient(to right, #6C63FF, #9B59B6);
                       -fx-text-fill: white; -fx-font-size: 14px;
                       -fx-font-weight: bold; -fx-pref-width: 350px;
                       -fx-pref-height: 44px; -fx-background-radius: 22;
                       -fx-cursor: hand;"/>

        <!-- Mot de passe oublié -->
        <HBox alignment="CENTER_RIGHT">
            <Button text="Mot de passe oublié ?"
                    onAction="#handleGoForgotPassword"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #6C63FF; -fx-font-size: 11px;
                           -fx-cursor: hand; -fx-underline: true;
                           -fx-border-color: transparent;"/>
        </HBox>

        <!-- Séparateur -->
        <HBox alignment="CENTER" spacing="10">
            <Separator prefWidth="140"/>
            <Label text="ou" style="-fx-text-fill: #95a5a6; -fx-font-size: 11px;"/>
            <Separator prefWidth="140"/>
        </HBox>

        <!-- ═══════════ BOUTON OAUTH GOOGLE ═══════════ -->
        <Button text="🔵  Se connecter avec Google"
                onAction="#handleGoogleLogin"
                style="-fx-background-color: white;
                       -fx-text-fill: #2c3e50; -fx-font-size: 13px;
                       -fx-font-weight: bold; -fx-pref-width: 350px;
                       -fx-pref-height: 42px; -fx-background-radius: 22;
                       -fx-border-color: #dadce0; -fx-border-radius: 22;
                       -fx-border-width: 1; -fx-cursor: hand;"/>

        <!-- ═══════════ BOUTON RECONNAISSANCE FACIALE ═══════════ -->
        <Button text="🎭  Se connecter avec mon visage"
                onAction="#handleFaceLogin"
                style="-fx-background-color: linear-gradient(to right, #16a085, #1abc9c);
                       -fx-text-fill: white; -fx-font-size: 13px;
                       -fx-font-weight: bold; -fx-pref-width: 350px;
                       -fx-pref-height: 42px; -fx-background-radius: 22;
                       -fx-cursor: hand;"/>

        <!-- Lien Register -->
        <HBox alignment="CENTER" spacing="5">
            <Label text="Pas encore de compte ?"
                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
            <Button text="S'inscrire"
                    onAction="#handleGoRegister"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #6C63FF; -fx-font-weight: bold;
                           -fx-font-size: 12px; -fx-cursor: hand;
                           -fx-underline: true; -fx-border-color: transparent;"/>
        </HBox>

    </VBox>
</HBox>