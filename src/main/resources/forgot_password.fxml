<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.ForgotPasswordController"
      prefWidth="520" prefHeight="520" alignment="CENTER" spacing="16"
      style="-fx-background-color: linear-gradient(to bottom right, #6C63FF, #9B59B6);">
    <padding><Insets top="40" bottom="40" left="60" right="60"/></padding>

    <Label text="🔐 Mot de passe oublié"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
    <Label text="Saisissez votre numéro de téléphone. Nous vous enverrons un code par WhatsApp."
           style="-fx-font-size: 13px; -fx-text-fill: #e8e0ff; -fx-wrap-text: true;"
           wrapText="true"/>

    <VBox spacing="5" style="-fx-background-color: white; -fx-background-radius: 12;
                             -fx-padding: 24;">
        <Label text="Téléphone (format +216XXXXXXXX)"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <TextField fx:id="tfPhone" promptText="+216..."
                   style="-fx-pref-height: 42px; -fx-font-size: 13px;
                          -fx-background-color: #f8f9fa;
                          -fx-border-color: #e0e0e0;
                          -fx-border-radius: 8; -fx-background-radius: 8;
                          -fx-padding: 0 12 0 12;"/>

        <Label fx:id="lblMessage" text="" style="-fx-font-size: 11px;"/>

        <Button text="Envoyer le code par WhatsApp" onAction="#handleSendCode"
                style="-fx-background-color: linear-gradient(to right, #6C63FF, #9B59B6);
                       -fx-text-fill: white; -fx-font-size: 14px;
                       -fx-font-weight: bold; -fx-pref-width: 350px;
                       -fx-pref-height: 44px; -fx-background-radius: 22;
                       -fx-cursor: hand;"/>

        <Button text="← Retour au login" onAction="#handleBackToLogin"
                style="-fx-background-color: transparent;
                       -fx-text-fill: #6C63FF; -fx-font-size: 12px;
                       -fx-cursor: hand; -fx-underline: true;
                       -fx-border-color: transparent;"/>
    </VBox>
</VBox>
