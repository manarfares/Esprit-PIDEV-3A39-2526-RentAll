<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.RegisterController"
      style="-fx-background-color: white;">

    <!-- ═══════════ PARTIE GAUCHE ═══════════ -->
    <VBox alignment="CENTER" HBox.hgrow="NEVER"
          prefWidth="500" minWidth="400"
          style="-fx-background-color: linear-gradient(to bottom right, #6C63FF, #9B59B6);">
        <padding><Insets top="60" bottom="60" left="50" right="50"/></padding>

        <Label text="🏠 RentAll"
               style="-fx-font-size: 42px; -fx-font-weight: bold;
                      -fx-text-fill: white;"/>

        <Label text=" " style="-fx-font-size: 15px;"/>

        <Label text="👥" style="-fx-font-size: 130px;"/>

        <Label text=" " style="-fx-font-size: 10px;"/>

        <Label text="Rejoignez RentAll"
               style="-fx-font-size: 22px; -fx-font-weight: bold;
                      -fx-text-fill: white;"/>

        <Label text="Créez votre compte et commencez à explorer"
               style="-fx-font-size: 13px; -fx-text-fill: #e8e0ff;
                      -fx-wrap-text: true; -fx-text-alignment: center;"
               wrapText="true"/>

        <Label text=" " style="-fx-font-size: 20px;"/>

        <VBox spacing="10" alignment="CENTER_LEFT">
            <Label text="✅ Accès à des milliers de logements"
                   style="-fx-font-size: 13px; -fx-text-fill: white;"/>
            <Label text="✅ Réservation simple et rapide"
                   style="-fx-font-size: 13px; -fx-text-fill: white;"/>
            <Label text="✅ Devenez Host et gérez vos annonces"
                   style="-fx-font-size: 13px; -fx-text-fill: white;"/>
        </VBox>
    </VBox>

    <!-- ═══════════ PARTIE DROITE ═══════════ -->
    <ScrollPane HBox.hgrow="ALWAYS"
                fitToWidth="true"
                hbarPolicy="NEVER"
                style="-fx-background: white;
                       -fx-background-color: white;
                       -fx-border-color: transparent;">

        <VBox alignment="TOP_CENTER" spacing="14"
              style="-fx-background-color: white;">
            <padding><Insets top="40" bottom="40" left="60" right="60"/></padding>

            <Label text="Créer un compte"
                   style="-fx-font-size: 30px; -fx-font-weight: bold;
                          -fx-text-fill: #2c3e50;"/>
            <Label text="Tous les nouveaux comptes sont Guest"
                   style="-fx-font-size: 12px; -fx-text-fill: #95a5a6;"/>

            <!-- Username -->
            <VBox spacing="4" maxWidth="420">
                <Label text="Nom d'utilisateur"
                       style="-fx-font-size: 12px; -fx-font-weight: bold;
                              -fx-text-fill: #2c3e50;"/>
                <TextField fx:id="tfUsername" promptText="min. 3 caractères"
                           style="-fx-pref-height: 42px; -fx-font-size: 13px;
                                  -fx-background-color: #f8f9fa;
                                  -fx-border-color: #e0e0e0;
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-padding: 0 12 0 12;"/>
                <Label fx:id="lblErrUsername" text=""
                       style="-fx-font-size: 10px; -fx-text-fill: #e74c3c;"/>
            </VBox>

            <!-- Email -->
            <VBox spacing="4" maxWidth="420">
                <Label text="Email"
                       style="-fx-font-size: 12px; -fx-font-weight: bold;
                              -fx-text-fill: #2c3e50;"/>
                <TextField fx:id="tfEmail" promptText="nom@gmail.com"
                           style="-fx-pref-height: 42px; -fx-font-size: 13px;
                                  -fx-background-color: #f8f9fa;
                                  -fx-border-color: #e0e0e0;
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-padding: 0 12 0 12;"/>
                <Label fx:id="lblErrEmail" text=""
                       style="-fx-font-size: 10px; -fx-text-fill: #e74c3c;"/>
            </VBox>

            <!-- Password -->
            <VBox spacing="4" maxWidth="420">
                <Label text="Mot de passe"
                       style="-fx-font-size: 12px; -fx-font-weight: bold;
                              -fx-text-fill: #2c3e50;"/>
                <PasswordField fx:id="pfPassword" promptText="min. 8 caractères"
                               style="-fx-pref-height: 42px; -fx-font-size: 13px;
                                      -fx-background-color: #f8f9fa;
                                      -fx-border-color: #e0e0e0;
                                      -fx-border-radius: 8; -fx-background-radius: 8;
                                      -fx-padding: 0 12 0 12;"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Force :"
                           style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;"/>
                    <Label fx:id="lblForce" text=""
                           style="-fx-font-size: 10px; -fx-font-weight: bold;"/>
                </HBox>
                <Label fx:id="lblErrPassword" text=""
                       style="-fx-font-size: 10px; -fx-text-fill: #e74c3c;"/>
            </VBox>

            <!-- Confirmer Password -->
            <VBox spacing="4" maxWidth="420">
                <Label text="Confirmer le mot de passe"
                       style="-fx-font-size: 12px; -fx-font-weight: bold;
                              -fx-text-fill: #2c3e50;"/>
                <PasswordField fx:id="pfConfirm" promptText="Répétez le mot de passe"
                               style="-fx-pref-height: 42px; -fx-font-size: 13px;
                                      -fx-background-color: #f8f9fa;
                                      -fx-border-color: #e0e0e0;
                                      -fx-border-radius: 8; -fx-background-radius: 8;
                                      -fx-padding: 0 12 0 12;"/>
                <Label fx:id="lblErrConfirm" text=""
                       style="-fx-font-size: 10px; -fx-text-fill: #e74c3c;"/>
            </VBox>

            <!-- Téléphone -->
            <VBox spacing="4" maxWidth="420">
                <Label text="Téléphone (format international, ex : +21612345678)"
                       style="-fx-font-size: 12px; -fx-font-weight: bold;
                              -fx-text-fill: #2c3e50;"/>
                <TextField fx:id="tfPhone" promptText="+216XXXXXXXX"
                           style="-fx-pref-height: 42px; -fx-font-size: 13px;
                                  -fx-background-color: #f8f9fa;
                                  -fx-border-color: #e0e0e0;
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-padding: 0 12 0 12;"/>
            </VBox>

            <!-- Message global -->
            <Label fx:id="lblMessage" text="" wrapText="true" maxWidth="420"
                   style="-fx-font-size: 12px;"/>

            <!-- Info : captcha automatique -->
            <Label text="🔒 Une vérification anti-robot s'ouvrira au moment de créer le compte."
                   wrapText="true" maxWidth="420"
                   style="-fx-font-size: 11px; -fx-text-fill: #95a5a6; -fx-text-alignment: center;"/>

            <!-- Bouton principal -->
            <Button text="Créer mon compte"
                    onAction="#handleRegister"
                    style="-fx-background-color: linear-gradient(to right, #6C63FF, #9B59B6);
                           -fx-text-fill: white; -fx-font-size: 14px;
                           -fx-font-weight: bold; -fx-pref-width: 420px;
                           -fx-pref-height: 46px; -fx-background-radius: 23;
                           -fx-cursor: hand;"/>

            <!-- Séparateur OAuth -->
            <HBox alignment="CENTER" spacing="10" maxWidth="420">
                <Separator prefWidth="170"/>
                <Label text="ou s'inscrire avec"
                       style="-fx-text-fill: #95a5a6; -fx-font-size: 11px;"/>
                <Separator prefWidth="170"/>
            </HBox>

            <!-- Bouton Google -->
            <Button text="🔵  S'inscrire avec Google"
                    onAction="#handleGoogleSignup"
                    style="-fx-background-color: white;
                           -fx-text-fill: #2c3e50; -fx-font-size: 13px;
                           -fx-font-weight: bold; -fx-pref-width: 420px;
                           -fx-pref-height: 44px; -fx-background-radius: 22;
                           -fx-border-color: #dadce0; -fx-border-radius: 22;
                           -fx-border-width: 1; -fx-cursor: hand;"/>

            <HBox alignment="CENTER" spacing="5">
                <Label text="Déjà un compte ?"
                       style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                <Button text="Se connecter" onAction="#handleGoLogin"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #6C63FF; -fx-font-weight: bold;
                               -fx-font-size: 12px; -fx-cursor: hand;
                               -fx-underline: true; -fx-border-color: transparent;"/>
            </HBox>

        </VBox>
    </ScrollPane>
</HBox>
