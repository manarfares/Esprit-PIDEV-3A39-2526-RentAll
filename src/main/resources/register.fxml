<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.RegisterController"
      prefWidth="900" prefHeight="620"
      style="-fx-background-color: white;">

    <!-- ═══════════ PARTIE GAUCHE ═══════════ -->
    <VBox prefWidth="450" prefHeight="620"
          alignment="CENTER"
          style="-fx-background-color: linear-gradient(to bottom right, #6C63FF, #9B59B6);">
        <padding><Insets top="60" bottom="60" left="50" right="50"/></padding>

        <Label text="🏠 RentAll"
               style="-fx-font-size: 36px; -fx-font-weight: bold;
                      -fx-text-fill: white;"/>

        <Label text=" " style="-fx-font-size: 15px;"/>

        <Label text="👥" style="-fx-font-size: 110px;"/>

        <Label text=" " style="-fx-font-size: 10px;"/>

        <Label text="Rejoignez RentAll"
               style="-fx-font-size: 18px; -fx-font-weight: bold;
                      -fx-text-fill: white;"/>

        <Label text="Créez votre compte et commencez à explorer"
               style="-fx-font-size: 12px; -fx-text-fill: #e8e0ff;
                      -fx-wrap-text: true; -fx-text-alignment: center;"
               wrapText="true"/>

        <Label text=" " style="-fx-font-size: 15px;"/>

        <!-- Avantages -->
        <VBox spacing="8" alignment="CENTER_LEFT">
            <Label text="✅ Accès à des milliers de logements"
                   style="-fx-font-size: 12px; -fx-text-fill: white;"/>
            <Label text="✅ Réservation simple et rapide"
                   style="-fx-font-size: 12px; -fx-text-fill: white;"/>
            <Label text="✅ Devenez Host et gérez vos annonces"
                   style="-fx-font-size: 12px; -fx-text-fill: white;"/>
        </VBox>

    </VBox>

    <!-- ═══════════ PARTIE DROITE ═══════════ -->
    <VBox prefWidth="450" prefHeight="620"
          alignment="CENTER" spacing="12"
          style="-fx-background-color: white;">
        <padding><Insets top="40" bottom="40" left="50" right="50"/></padding>

        <Label text="Créer un compte"
               style="-fx-font-size: 26px; -fx-font-weight: bold;
                      -fx-text-fill: #2c3e50;"/>
        <Label text="Tous les nouveaux comptes sont Guest"
               style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;"/>

        <Label text=" " style="-fx-font-size: 3px;"/>

        <!-- Username -->
        <VBox spacing="4">
            <Label text="Nom d'utilisateur"
                   style="-fx-font-size: 12px; -fx-font-weight: bold;
                          -fx-text-fill: #2c3e50;"/>
            <TextField fx:id="tfUsername"
                       promptText="Choisissez un username"
                       style="-fx-pref-height: 40px; -fx-font-size: 13px;
                              -fx-background-color: #f8f9fa;
                              -fx-border-color: #e0e0e0;
                              -fx-border-radius: 8; -fx-background-radius: 8;
                              -fx-padding: 0 12 0 12;"/>
        </VBox>

        <!-- Email -->
        <VBox spacing="4">
            <Label text="Email"
                   style="-fx-font-size: 12px; -fx-font-weight: bold;
                          -fx-text-fill: #2c3e50;"/>
            <TextField fx:id="tfEmail"
                       promptText="exemple@mail.com"
                       style="-fx-pref-height: 40px; -fx-font-size: 13px;
                              -fx-background-color: #f8f9fa;
                              -fx-border-color: #e0e0e0;
                              -fx-border-radius: 8; -fx-background-radius: 8;
                              -fx-padding: 0 12 0 12;"/>
        </VBox>

        <!-- Password -->
        <VBox spacing="4">
            <Label text="Mot de passe"
                   style="-fx-font-size: 12px; -fx-font-weight: bold;
                          -fx-text-fill: #2c3e50;"/>
            <PasswordField fx:id="pfPassword"
                           promptText="Min. 6 caractères"
                           style="-fx-pref-height: 40px; -fx-font-size: 13px;
                                  -fx-background-color: #f8f9fa;
                                  -fx-border-color: #e0e0e0;
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-padding: 0 12 0 12;"/>
        </VBox>

        <!-- Confirmer Password -->
        <VBox spacing="4">
            <Label text="Confirmer le mot de passe"
                   style="-fx-font-size: 12px; -fx-font-weight: bold;
                          -fx-text-fill: #2c3e50;"/>
            <PasswordField fx:id="pfConfirm"
                           promptText="Répétez le mot de passe"
                           style="-fx-pref-height: 40px; -fx-font-size: 13px;
                                  -fx-background-color: #f8f9fa;
                                  -fx-border-color: #e0e0e0;
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-padding: 0 12 0 12;"/>
        </VBox>

        <!-- Message -->
        <Label fx:id="lblMessage" text=""
               style="-fx-font-size: 11px;"/>

        <!-- Bouton -->
        <Button text="Créer mon compte"
                onAction="#handleRegister"
                style="-fx-background-color: linear-gradient(to right, #6C63FF, #9B59B6);
                       -fx-text-fill: white; -fx-font-size: 14px;
                       -fx-font-weight: bold; -fx-pref-width: 350px;
                       -fx-pref-height: 44px; -fx-background-radius: 22;
                       -fx-cursor: hand;"/>

        <!-- Retour Login -->
        <HBox alignment="CENTER" spacing="5">
            <Label text="Déjà un compte ?"
                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
            <Button text="Se connecter"
                    onAction="#handleGoLogin"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #6C63FF; -fx-font-weight: bold;
                           -fx-font-size: 12px; -fx-cursor: hand;
                           -fx-underline: true; -fx-border-color: transparent;"/>
        </HBox>

    </VBox>
</HBox>