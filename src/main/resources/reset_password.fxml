<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.ResetPasswordController"
      prefWidth="520" prefHeight="580" alignment="CENTER" spacing="16"
      style="-fx-background-color: linear-gradient(to bottom right, #6C63FF, #9B59B6);">
    <padding><Insets top="40" bottom="40" left="60" right="60"/></padding>

    <Label text="🔑 Nouveau mot de passe"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
    <Label text="Entrez le code reçu par WhatsApp et choisissez un nouveau mot de passe."
           style="-fx-font-size: 13px; -fx-text-fill: #e8e0ff; -fx-wrap-text: true;"
           wrapText="true"/>

    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12;
                              -fx-padding: 24;">
        <Label text="Code reçu par WhatsApp (6 chiffres)"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <TextField fx:id="tfCode" promptText="123456"
                   style="-fx-pref-height: 42px; -fx-font-size: 16px;
                          -fx-background-color: #f8f9fa;
                          -fx-border-color: #e0e0e0;
                          -fx-border-radius: 8; -fx-background-radius: 8;
                          -fx-padding: 0 12 0 12;"/>

        <Label text="Nouveau mot de passe"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <PasswordField fx:id="pfNewPassword" promptText="min. 8 caractères"
                       style="-fx-pref-height: 42px; -fx-font-size: 13px;
                              -fx-background-color: #f8f9fa;
                              -fx-border-color: #e0e0e0;
                              -fx-border-radius: 8; -fx-background-radius: 8;
                              -fx-padding: 0 12 0 12;"/>

        <Label text="Confirmer"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <PasswordField fx:id="pfConfirm" promptText="Répétez"
                       style="-fx-pref-height: 42px; -fx-font-size: 13px;
                              -fx-background-color: #f8f9fa;
                              -fx-border-color: #e0e0e0;
                              -fx-border-radius: 8; -fx-background-radius: 8;
                              -fx-padding: 0 12 0 12;"/>

        <Label fx:id="lblMessage" text="" style="-fx-font-size: 11px;"/>

        <Button text="Réinitialiser" onAction="#handleReset"
                style="-fx-background-color: linear-gradient(to right, #6C63FF, #9B59B6);
                       -fx-text-fill: white; -fx-font-size: 14px;
                       -fx-font-weight: bold; -fx-pref-width: 350px;
                       -fx-pref-height: 44px; -fx-background-radius: 22;
                       -fx-cursor: hand;"/>
    </VBox>
</VBox>
