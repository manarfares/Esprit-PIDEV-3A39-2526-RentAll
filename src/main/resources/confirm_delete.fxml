<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.DeleteUserController"
      prefWidth="430" prefHeight="300"
      spacing="0"
      alignment="TOP_CENTER"
      style="-fx-background-color: white;">

    <!-- ═══════════ HEADER ═══════════ -->
    <HBox style="-fx-background-color: linear-gradient(to right, #e74c3c, #c0392b);
                 -fx-padding: 20 25 20 25;"
          alignment="CENTER_LEFT" spacing="10">
        <Label text="🗑️" style="-fx-font-size: 20px;"/>
        <Label text="Confirmer la suppression"
               style="-fx-font-size: 16px; -fx-font-weight: bold;
                      -fx-text-fill: white;"/>
    </HBox>

    <!-- ═══════════ CONTENU ═══════════ -->
    <VBox spacing="20" alignment="CENTER"
          style="-fx-padding: 30 25 25 25;">

        <!-- Icône warning -->
        <Label text="⚠️"
               style="-fx-font-size: 48px;"/>

        <!-- Info utilisateur -->
        <VBox alignment="CENTER" spacing="5"
              style="-fx-background-color: #fef9e7;
                     -fx-padding: 15; -fx-background-radius: 10;">
            <Label fx:id="lblConfirmation"
                   style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;
                          -fx-wrap-text: true; -fx-text-alignment: center;
                          -fx-font-weight: bold;"
                   text="" wrapText="true"/>
        </VBox>

        <!-- Message -->
        <Label fx:id="lblMessage" text=""
               style="-fx-font-size: 11px;"/>

        <!-- Boutons -->
        <HBox spacing="12" alignment="CENTER">
            <Button text="🗑️ Supprimer"
                    onAction="#handleConfirmer"
                    style="-fx-background-color: linear-gradient(to right, #e74c3c, #c0392b);
                           -fx-text-fill: white; -fx-font-size: 13px;
                           -fx-font-weight: bold; -fx-pref-width: 180px;
                           -fx-pref-height: 42px; -fx-background-radius: 21;
                           -fx-cursor: hand;"/>
            <Button text="↩️ Annuler"
                    onAction="#handleAnnuler"
                    style="-fx-background-color: white;
                           -fx-text-fill: #7f8c8d; -fx-font-size: 13px;
                           -fx-font-weight: bold; -fx-pref-width: 180px;
                           -fx-pref-height: 42px; -fx-background-radius: 21;
                           -fx-cursor: hand; -fx-border-color: #e0e0e0;
                           -fx-border-radius: 21;"/>
        </HBox>

    </VBox>
</VBox>