<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

    <!-- Top bar: action buttons + status -->
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button fx:id="btnAdd" text="+ Add"
                style="-fx-background-color: #3a7bd5; -fx-text-fill: white;"/>
        <Button fx:id="btnEdit" text="✎ Edit"/>
        <Button fx:id="btnDelete" text="✕ Delete"
                style="-fx-background-color: #d9534f; -fx-text-fill: white;"/>
        <Button fx:id="btnRefresh" text="↺ Refresh"/>
        <Label fx:id="lblStatus" style="-fx-padding: 0 0 0 12;"/>
    </HBox>

    <!-- Search and filter bar -->
    <VBox spacing="8" style="-fx-background-color: #f8f8f8; -fx-border-color: #ddd; -fx-border-radius: 6; -fx-background-radius: 6;">
        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
        <Label text="Search &amp; Filter" style="-fx-font-weight: bold;"/>
        <TextField fx:id="tfSearch" promptText="Search by name or address..."/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Min price:"/>
            <TextField fx:id="tfMinPrice" promptText="0" prefWidth="80"/>
            <Label text="Max price:"/>
            <TextField fx:id="tfMaxPrice" promptText="any" prefWidth="80"/>
            <Label text="Min rooms:"/>
            <TextField fx:id="tfMinRooms" promptText="0" prefWidth="60"/>
            <Button fx:id="btnClearFilters" text="Clear"/>
        </HBox>
    </VBox>

    <!-- Selected record indicator -->
    <Label fx:id="lblSelected" text="No record selected"
           style="-fx-text-fill: gray; -fx-font-style: italic;"/>

    <!-- Scrollable card grid -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <FlowPane fx:id="cardGrid" hgap="12" vgap="12">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
        </FlowPane>
    </ScrollPane>

</VBox>
