<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controllers.HostController"
            prefWidth="950" prefHeight="650"
            style="-fx-background-color: #f8f9fa;">

    <!-- ═══════════ HEADER ═══════════ -->
    <top>
        <HBox style="-fx-background-color: linear-gradient(to right, #6C63FF, #9B59B6);
                     -fx-padding: 15 25 15 25;"
              alignment="CENTER_LEFT" spacing="20">

            <Label text="🏠 RentAll"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;
                          -fx-text-fill: white;"/>

            <Label text="Host"
                   style="-fx-font-size: 11px; -fx-text-fill: #e8e0ff;
                          -fx-background-color: rgba(255,255,255,0.2);
                          -fx-padding: 3 8 3 8; -fx-background-radius: 10;"/>

            <HBox HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblWelcome"
                   style="-fx-font-size: 13px; -fx-text-fill: white;"/>

            <Button text="🚪 Déconnexion"
                    onAction="#handleLogout"
                    style="-fx-background-color: rgba(255,255,255,0.2);
                           -fx-text-fill: white; -fx-font-size: 12px;
                           -fx-background-radius: 20; -fx-cursor: hand;
                           -fx-padding: 8 16 8 16;"/>
        </HBox>
    </top>

    <!-- ═══════════ CONTENU ═══════════ -->
    <center>
        <HBox spacing="20" style="-fx-padding: 25;">

            <!-- ── Carte Profil ── -->
            <VBox spacing="15" prefWidth="420"
                  style="-fx-background-color: white;
                         -fx-border-color: #e0e0e0;
                         -fx-border-radius: 12;
                         -fx-background-radius: 12;
                         -fx-padding: 25;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">

                <!-- Titre -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="🏠" style="-fx-font-size: 28px;"/>
                    <VBox>
                        <Label text="Profil Host"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;
                                      -fx-text-fill: #2c3e50;"/>
                        <HBox spacing="8">
                            <Label fx:id="lblRole"
                                   style="-fx-font-size: 11px;
                                          -fx-text-fill: #6C63FF;
                                          -fx-font-weight: bold;"/>
                            <Label text="•"
                                   style="-fx-text-fill: #95a5a6;"/>
                            <Label fx:id="lblStatus"
                                   style="-fx-font-size: 11px;
                                          -fx-text-fill: #27ae60;"/>
                        </HBox>
                    </VBox>
                </HBox>

                <Separator/>

                <!-- Username -->
                <VBox spacing="4">
                    <Label text="Nom d'utilisateur"
                           style="-fx-font-size: 11px; -fx-font-weight: bold;
                                  -fx-text-fill: #7f8c8d;"/>
                    <TextField fx:id="tfUsername"
                               style="-fx-pref-height: 40px; -fx-font-size: 13px;
                                      -fx-background-color: #f8f9fa;
                                      -fx-border-color: #e0e0e0;
                                      -fx-border-radius: 8; -fx-background-radius: 8;
                                      -fx-padding: 0 12 0 12;"/>
                </VBox>

                <!-- Email -->
                <VBox spacing="4">
                    <Label text="Email"
                           style="-fx-font-size: 11px; -fx-font-weight: bold;
                                  -fx-text-fill: #7f8c8d;"/>
                    <TextField fx:id="tfEmail"
                               style="-fx-pref-height: 40px; -fx-font-size: 13px;
                                      -fx-background-color: #f8f9fa;
                                      -fx-border-color: #e0e0e0;
                                      -fx-border-radius: 8; -fx-background-radius: 8;
                                      -fx-padding: 0 12 0 12;"/>
                </VBox>

                <!-- Phone -->
                <VBox spacing="4">
                    <Label text="Téléphone (optionnel)"
                           style="-fx-font-size: 11px; -fx-font-weight: bold;
                                  -fx-text-fill: #7f8c8d;"/>
                    <TextField fx:id="tfPhone"
                               promptText="+216 XX XXX XXX"
                               style="-fx-pref-height: 40px; -fx-font-size: 13px;
                                      -fx-background-color: #f8f9fa;
                                      -fx-border-color: #e0e0e0;
                                      -fx-border-radius: 8; -fx-background-radius: 8;
                                      -fx-padding: 0 12 0 12;"/>
                </VBox>

                <!-- Password -->
                <VBox spacing="4">
                    <Label text="Nouveau mot de passe (vide = inchangé)"
                           style="-fx-font-size: 11px; -fx-font-weight: bold;
                                  -fx-text-fill: #7f8c8d;"/>
                    <PasswordField fx:id="pfPassword"
                                   promptText="••••••••"
                                   style="-fx-pref-height: 40px; -fx-font-size: 13px;
                                          -fx-background-color: #f8f9fa;
                                          -fx-border-color: #e0e0e0;
                                          -fx-border-radius: 8; -fx-background-radius: 8;
                                          -fx-padding: 0 12 0 12;"/>
                </VBox>

                <!-- Message -->
                <Label fx:id="lblMessage" text=""
                       style="-fx-font-size: 11px;"/>

                <!-- Bouton Modifier -->
                <Button text="💾 Enregistrer les modifications"
                        onAction="#handleUpdate"
                        style="-fx-background-color: linear-gradient(to right, #6C63FF, #9B59B6);
                               -fx-text-fill: white; -fx-font-size: 13px;
                               -fx-font-weight: bold; -fx-pref-width: 370px;
                               -fx-pref-height: 42px; -fx-background-radius: 21;
                               -fx-cursor: hand;"/>

            </VBox>

            <!-- ── Carte Actions Host ── -->
            <VBox spacing="15" prefWidth="420"
                  style="-fx-background-color: white;
                         -fx-border-color: #e0e0e0;
                         -fx-border-radius: 12;
                         -fx-background-radius: 12;
                         -fx-padding: 25;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">

                <!-- Titre -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="⚡" style="-fx-font-size: 28px;"/>
                    <Label text="Actions Host"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;
                                  -fx-text-fill: #2c3e50;"/>
                </HBox>

                <Separator/>

                <Label text="Gérez vos propriétés et réservations"
                       style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>

                <!-- Stats -->
                <HBox spacing="10">
                    <VBox alignment="CENTER" prefWidth="120"
                          style="-fx-background-color: #f0eeff;
                                 -fx-padding: 15; -fx-background-radius: 10;">
                        <Label text="🏠"
                               style="-fx-font-size: 24px;"/>
                        <Label text="—"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;
                                      -fx-text-fill: #6C63FF;"/>
                        <Label text="Annonces"
                               style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                    </VBox>
                    <VBox alignment="CENTER" prefWidth="120"
                          style="-fx-background-color: #e8f8f5;
                                 -fx-padding: 15; -fx-background-radius: 10;">
                        <Label text="📅"
                               style="-fx-font-size: 24px;"/>
                        <Label text="—"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;
                                      -fx-text-fill: #16a085;"/>
                        <Label text="Réservations"
                               style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                    </VBox>
                    <VBox alignment="CENTER" prefWidth="120"
                          style="-fx-background-color: #fef9e7;
                                 -fx-padding: 15; -fx-background-radius: 10;">
                        <Label text="💰"
                               style="-fx-font-size: 24px;"/>
                        <Label text="—"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;
                                      -fx-text-fill: #f39c12;"/>
                        <Label text="Revenus"
                               style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                    </VBox>
                </HBox>

                <Separator/>

                <VBox spacing="12">
                    <Button text="🏠 Gérer mes annonces"
                            onAction="#handleGererAnnonces"
                            style="-fx-background-color: linear-gradient(to right, #6C63FF, #9B59B6);
                                   -fx-text-fill: white; -fx-font-size: 13px;
                                   -fx-font-weight: bold; -fx-pref-width: 370px;
                                   -fx-pref-height: 42px; -fx-background-radius: 21;
                                   -fx-cursor: hand;"/>
                    <!-- Bouton Retour Accueil -->
                    <Button text="🏠 Retour à l'accueil"
                            onAction="#handleRetourAccueil"
                            style="-fx-background-color: white;
               -fx-text-fill: #6C63FF; -fx-font-size: 13px;
               -fx-font-weight: bold; -fx-pref-width: 370px;
               -fx-pref-height: 42px; -fx-background-radius: 21;
               -fx-cursor: hand; -fx-border-color: #6C63FF;
               -fx-border-radius: 21;"/>

                    <Button text="📅 Voir mes réservations"
                            onAction="#handleVoirReservations"
                            style="-fx-background-color: white;
                                   -fx-text-fill: #6C63FF; -fx-font-size: 13px;
                                   -fx-font-weight: bold; -fx-pref-width: 370px;
                                   -fx-pref-height: 42px; -fx-background-radius: 21;
                                   -fx-cursor: hand; -fx-border-color: #6C63FF;
                                   -fx-border-radius: 21;"/>
                </VBox>

            </VBox>

        </HBox>
    </center>

</BorderPane>