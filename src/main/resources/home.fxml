<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controllers.HomeController"
            prefWidth="1100" prefHeight="700"
            style="-fx-background-color: #f8f9fa;">

    <!-- ═══════════ NAVBAR ═══════════ -->
    <top>
        <VBox>
            <HBox style="-fx-background-color: white;
                         -fx-padding: 12 25 12 25;
                         -fx-border-color: #e0e0e0;
                         -fx-border-width: 0 0 1 0;"
                  alignment="CENTER_LEFT" spacing="25">

                <!-- Logo -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="🏠"
                           style="-fx-font-size: 22px;"/>
                    <Label text="RentAll"
                           style="-fx-font-size: 20px; -fx-font-weight: bold;
                                  -fx-text-fill: #6C63FF;"/>
                </HBox>

                <!-- Nav Links -->
                <HBox spacing="20" alignment="CENTER_LEFT"
                      HBox.hgrow="ALWAYS">
                    <Button text="🏠 Stays"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #2c3e50; -fx-font-size: 13px;
                                   -fx-cursor: hand; -fx-border-color: transparent;"/>
                    <Button text="🗺️ Carte"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #2c3e50; -fx-font-size: 13px;
                                   -fx-cursor: hand; -fx-border-color: transparent;"/>
                    <Button text="🔧 Services"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #2c3e50; -fx-font-size: 13px;
                                   -fx-cursor: hand; -fx-border-color: transparent;"/>
                    <Button text="🚗 Covoiturage"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #2c3e50; -fx-font-size: 13px;
                                   -fx-cursor: hand; -fx-border-color: transparent;"/>
                    <Button text="📅 Mes réservations"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #2c3e50; -fx-font-size: 13px;
                                   -fx-cursor: hand; -fx-border-color: transparent;"/>
                </HBox>

                <!-- Profil + Déconnexion -->
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Label fx:id="lblRoleBadge" text="Guest"/>
                    <Label fx:id="lblUsername"
                           style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                    <Button fx:id="btnProfil"
                            onAction="#handleOuvrirProfil"
                            style="-fx-background-color: linear-gradient(to right, #6C63FF, #9B59B6);
                                   -fx-text-fill: white; -fx-font-size: 14px;
                                   -fx-font-weight: bold;
                                   -fx-min-width: 40px; -fx-min-height: 40px;
                                   -fx-max-width: 40px; -fx-max-height: 40px;
                                   -fx-background-radius: 20; -fx-cursor: hand;"/>
                    <Button text="🚪"
                            onAction="#handleLogout"
                            style="-fx-background-color: #f8f9fa;
                                   -fx-text-fill: #e74c3c; -fx-font-size: 14px;
                                   -fx-min-width: 40px; -fx-min-height: 40px;
                                   -fx-max-width: 40px; -fx-max-height: 40px;
                                   -fx-background-radius: 20; -fx-cursor: hand;
                                   -fx-border-color: #e0e0e0; -fx-border-radius: 20;"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- ═══════════ CONTENU ═══════════ -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;
                           -fx-border-color: transparent;">
            <VBox spacing="0">

                <!-- ── Hero Banner ── -->
                <StackPane prefHeight="280"
                           style="-fx-background-color: linear-gradient(to bottom right, #6C63FF, #9B59B6);">
                    <VBox alignment="CENTER" spacing="15">
                        <padding><Insets top="50" bottom="50" left="50" right="50"/></padding>

                        <Label text="Trouvez votre séjour idéal"
                               style="-fx-font-size: 36px; -fx-font-weight: bold;
                                      -fx-text-fill: white;"/>

                        <Label text="Découvrez des logements uniques partout dans le monde"
                               style="-fx-font-size: 14px; -fx-text-fill: #e8e0ff;"/>

                        <!-- Barre de recherche -->
                        <HBox spacing="0" alignment="CENTER"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 30;
                                     -fx-padding: 8 8 8 20;
                                     -fx-max-width: 700px;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 5);">
                            <Label text="🔍"
                                   style="-fx-font-size: 16px; -fx-text-fill: #6C63FF;"/>
                            <TextField promptText="Rechercher par localisation ou titre..."
                                       HBox.hgrow="ALWAYS"
                                       style="-fx-background-color: transparent;
                                              -fx-border-color: transparent;
                                              -fx-font-size: 13px; -fx-padding: 5 10 5 10;"/>
                            <Button text="🔍 Rechercher"
                                    onAction="#handleRechercher"
                                    style="-fx-background-color: linear-gradient(to right, #6C63FF, #9B59B6);
                                           -fx-text-fill: white; -fx-font-size: 13px;
                                           -fx-font-weight: bold;
                                           -fx-padding: 10 20 10 20;
                                           -fx-background-radius: 22; -fx-cursor: hand;"/>
                        </HBox>

                    </VBox>
                </StackPane>

                <!-- ── Logements ── -->
                <VBox spacing="20" style="-fx-padding: 30 25 30 25;">

                    <Label fx:id="lblSearchResult"
                           text="🏠 Logements disponibles"
                           style="-fx-font-size: 20px; -fx-font-weight: bold;
                                  -fx-text-fill: #2c3e50;"/>

                    <!-- Ligne 1 -->
                    <HBox spacing="20">
                        <!-- Carte 1 -->
                        <VBox spacing="8" prefWidth="240"
                              style="-fx-background-color: white;
                                     -fx-border-radius: 12; -fx-background-radius: 12;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);
                                     -fx-cursor: hand;">
                            <StackPane prefHeight="160"
                                       style="-fx-background-color: linear-gradient(to bottom right, #a29bfe, #6C63FF);
                                              -fx-background-radius: 12 12 0 0;">
                                <Label text="🏠"
                                       style="-fx-font-size: 50px;"/>
                                <Label text="Appartement"
                                       style="-fx-background-color: rgba(0,0,0,0.4);
                                              -fx-text-fill: white; -fx-font-size: 11px;
                                              -fx-padding: 4 8 4 8; -fx-background-radius: 5;"
                                       StackPane.alignment="TOP_LEFT">
                                    <StackPane.margin>
                                        <Insets top="10" left="10"/>
                                    </StackPane.margin>
                                </Label>
                            </StackPane>
                            <VBox spacing="4" style="-fx-padding: 12;">
                                <Label text="Bel appartement centre-ville"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold;
                                              -fx-text-fill: #2c3e50;"/>
                                <Label text="📍 Tunis, Tunisie"
                                       style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;"/>
                                <Label text="120 DT / nuit"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold;
                                              -fx-text-fill: #6C63FF;"/>
                            </VBox>
                        </VBox>

                        <!-- Carte 2 -->
                        <VBox spacing="8" prefWidth="240"
                              style="-fx-background-color: white;
                                     -fx-border-radius: 12; -fx-background-radius: 12;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);
                                     -fx-cursor: hand;">
                            <StackPane prefHeight="160"
                                       style="-fx-background-color: linear-gradient(to bottom right, #fd79a8, #e84393);
                                              -fx-background-radius: 12 12 0 0;">
                                <Label text="🏖️"
                                       style="-fx-font-size: 50px;"/>
                                <Label text="Villa"
                                       style="-fx-background-color: rgba(0,0,0,0.4);
                                              -fx-text-fill: white; -fx-font-size: 11px;
                                              -fx-padding: 4 8 4 8; -fx-background-radius: 5;"
                                       StackPane.alignment="TOP_LEFT">
                                    <StackPane.margin>
                                        <Insets top="10" left="10"/>
                                    </StackPane.margin>
                                </Label>
                            </StackPane>
                            <VBox spacing="4" style="-fx-padding: 12;">
                                <Label text="Villa avec piscine vue mer"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold;
                                              -fx-text-fill: #2c3e50;"/>
                                <Label text="📍 Hammamet, Tunisie"
                                       style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;"/>
                                <Label text="350 DT / nuit"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold;
                                              -fx-text-fill: #6C63FF;"/>
                            </VBox>
                        </VBox>

                        <!-- Carte 3 -->
                        <VBox spacing="8" prefWidth="240"
                              style="-fx-background-color: white;
                                     -fx-border-radius: 12; -fx-background-radius: 12;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);
                                     -fx-cursor: hand;">
                            <StackPane prefHeight="160"
                                       style="-fx-background-color: linear-gradient(to bottom right, #55efc4, #00b894);
                                              -fx-background-radius: 12 12 0 0;">
                                <Label text="🏡"
                                       style="-fx-font-size: 50px;"/>
                                <Label text="Maison"
                                       style="-fx-background-color: rgba(0,0,0,0.4);
                                              -fx-text-fill: white; -fx-font-size: 11px;
                                              -fx-padding: 4 8 4 8; -fx-background-radius: 5;"
                                       StackPane.alignment="TOP_LEFT">
                                    <StackPane.margin>
                                        <Insets top="10" left="10"/>
                                    </StackPane.margin>
                                </Label>
                            </StackPane>
                            <VBox spacing="4" style="-fx-padding: 12;">
                                <Label text="Maison traditionnelle médina"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold;
                                              -fx-text-fill: #2c3e50;"/>
                                <Label text="📍 Sousse, Tunisie"
                                       style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;"/>
                                <Label text="85 DT / nuit"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold;
                                              -fx-text-fill: #6C63FF;"/>
                            </VBox>
                        </VBox>

                        <!-- Carte 4 -->
                        <VBox spacing="8" prefWidth="240"
                              style="-fx-background-color: white;
                                     -fx-border-radius: 12; -fx-background-radius: 12;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);
                                     -fx-cursor: hand;">
                            <StackPane prefHeight="160"
                                       style="-fx-background-color: linear-gradient(to bottom right, #fdcb6e, #e17055);
                                              -fx-background-radius: 12 12 0 0;">
                                <Label text="🏢"
                                       style="-fx-font-size: 50px;"/>
                                <Label text="Studio"
                                       style="-fx-background-color: rgba(0,0,0,0.4);
                                              -fx-text-fill: white; -fx-font-size: 11px;
                                              -fx-padding: 4 8 4 8; -fx-background-radius: 5;"
                                       StackPane.alignment="TOP_LEFT">
                                    <StackPane.margin>
                                        <Insets top="10" left="10"/>
                                    </StackPane.margin>
                                </Label>
                            </StackPane>
                            <VBox spacing="4" style="-fx-padding: 12;">
                                <Label text="Studio moderne tout équipé"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold;
                                              -fx-text-fill: #2c3e50;"/>
                                <Label text="📍 Sfax, Tunisie"
                                       style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;"/>
                                <Label text="55 DT / nuit"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold;
                                              -fx-text-fill: #6C63FF;"/>
                            </VBox>
                        </VBox>

                    </HBox>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>